{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*/.env*", "effect": "deny" },
    { "action": "read", "resource": "*supabase-battery-token*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*/.env*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": ".env*", "effect": "deny" },
    { "action": "grep", "resource": "*.env", "effect": "deny" },
    { "action": "grep", "resource": "*.env.*", "effect": "deny" },
    { "action": "grep", "resource": "*/.env*", "effect": "deny" },
    { "action": "grep", "resource": "*supabase-battery-token*", "effect": "deny" },
    { "action": "grep", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*/.env*", "effect": "deny" },
    { "action": "shell", "resource": "*supabase-battery-token*", "effect": "deny" },
    { "action": "shell", "resource": "echo *SECRET*", "effect": "deny" },
    { "action": "shell", "resource": "echo *KEY*", "effect": "deny" },
    { "action": "shell", "resource": "*env.example*", "effect": "allow" }
  ]
}
